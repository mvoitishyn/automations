# meet configuration: copy to ~/.config/automations/meet.env and edit.
# Every line is optional; shell syntax (it is sourced).

# Where meeting folders go: point it inside your Obsidian vault.
MEET_DIR="$HOME/Documents/meetings"

# Who you are and what you do, so the summary gets names and jargon right.
MEET_OWNER="Your Name"
MEET_ABOUT="Engineer at Example Corp. Jargon: SLO = service level objective."

# Names the speech recogniser keeps getting wrong.
MEET_GLOSSARY="Akme -> Acme; cubernetes -> Kubernetes"

# A vault folder with one note per client/project; the summary links the matching one.
#MEET_CLIENTS_DIR="$HOME/Documents/vault/clients"

# Transcription: faster-whisper model and language (small.en is fast; large-v3-turbo for other languages).
#MEET_WHISPER_MODEL="small.en"
#MEET_LANG="da"

# Summariser, self-hosted only. First reachable wins:
#MEET_LLM_URL="http://your-gpu-server:8000/v1"; MEET_LLM_MODEL="your-model"; MEET_LLM_KEY=""
#MEET_PI_PROVIDER="vllm"          # reuse a provider from pi's ~/.pi/agent/models.json
MEET_LOCAL_URL="http://localhost:11434/v1"
MEET_LOCAL_MODEL="qwen3:4b-instruct-2507-q4_K_M"

# Where the recording state and log live.
#MEET_STATE_DIR="$HOME/.local/state/meet"
